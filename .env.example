# Copy to `.env` for local runs. Loaded automatically by src/common/config/load-env.ts.
# Real environment variables (e.g. CI secrets) always win over values set here, even blank ones.
# E2E_LOAD_DOTENV=false in the ENVIRONMENT skips this file entirely — every value below, the
# BackWPup credentials included (`E2E_LOAD_DOTENV=false npm run test:backwpup`). Set inside this
# file it has no effect (the file is already being read) and a warning says so.

# ── Runtime flags (optional; sensible defaults) ──────────────────────────────
# Reporting mode: unset = self-contained portable report; "rich" = external
# attachments + embedded trace viewer (serve over http).
# REPORT_MODE=rich

# Per-run report token. Auto-stamped when unset; an orchestrator may pin it so a
# batch of cells shares one token.
# RUN_ID=

# Display only — what the reports call the run (default: its RUN_ID) and the plugin ref it was asked
# for, which an orchestrator pins to the commit it built. Shown in the reports, never acted on.
# E2E_RUN_NAME=
# E2E_REQUESTED_REF=

# Set non-empty in CI to enable CI-only config (forbidOnly; retries apply everywhere, see E2E_RETRIES).
# CI=

# E2E_CELL=<cell> pins a run to one cell, so bddgen regenerates only that cell's specs and
# two cells of one product can run side by side. Pass it on the command line instead
# (`E2E_CELL=pro@nginx npm run test:backwpup`): set here, it would pin EVERY run started from
# this folder, and a `--project` naming another cell would fail.

# Artifact root overrides, relative to the repository root or absolute. The
# `<product>/<cell>` namespace is always appended, so cells never collide
# regardless of these values. ARTIFACTS_ROOT holds the
# resolved plugin zips under test and is wiped & rebuilt on every run.
# REPORT_ROOT=reports
# OUTPUT_ROOT=test-results
# AUTH_ROOT=.auth
# ARTIFACTS_ROOT=.artifacts

# ── Plugin artifacts under test (APVM build/verify) ──────────────────────────
# Which plugin zips a run resolves, builds (via APVM), and verifies. Two roles:
# `plugin` (the artifact under test) and `previous` (an older artifact some tests
# compare against). Leave all unset to use each product's defaults (develop / latest
# stable). Overrides apply only to a run of one cell — pinned with `E2E_CELL=<cell>`, or named
# exactly with `--project=<cell>`; on a serial (cell-less) run, or an unpinned wildcard selection,
# they are ignored with a warning and the defaults are used (never a hard failure). Full
# reference: docs/guides/configuration.md.
#
# Per role, set EITHER a git ref OR a prebuilt zip path — never both (that errors; neither
# wins by default). A ref is any APVM ref: branch/tag/commit/PR, `tag:latest-stable`,
# `release:5.6.8`, etc. A zip path is absolute or repo-root-relative; keep it OUT of
# ARTIFACTS_ROOT, whose per-cell directories are wiped whole every time that cell resolves
# (pointing at the running cell's own directory is rejected rather than deleting the file).
# E2E_PLUGIN_REF=
# E2E_PLUGIN_ZIP=
# E2E_PREVIOUS_REF=
# E2E_PREVIOUS_ZIP=
#
# Version to build with (BackWPup only — required by its builder; WP Rocket/Imagify embed
# their version, but an override here is still applied). Ignored (warned) with a `_ZIP` path
# or a `release:*` ref. Unset → the product default (BackWPup: 9.99.99 plugin / 9.99.98
# previous, staggered so `previous` is older). `E2E_PREVIOUS_*` vars are ignored on products
# with no `previous` role yet (e.g. BackWPup).
# E2E_PLUGIN_VERSION=
# E2E_PREVIOUS_VERSION=

# ── Site staging area (artifacts placed ON the site under test) ──────────────
# WP-CLI reads files from the site's filesystem, so a plugin zip (or import, or DB
# dump) resolved on the runner is copied into a staging directory on the target
# first. Default: `.e2e_temp` under that site's WordPress root — which is also the
# web docroot here, so staged files are potentially HTTP-reachable (they are wiped
# after the run). Set this to an absolute path, or one relative to the WordPress
# root, when the transport's user cannot write the docroot or the files must live
# outside it. A site's own `transport.stagingDir` in sites.json overrides this. It must
# be a DEDICATED directory — cleanup removes it whole, so the WordPress root itself, any
# parent of it, and top-level paths like /var are rejected.
# E2E_SITE_STAGING_DIR=.e2e_temp

# ── Retries ──────────────────────────────────────────────────────────────────
# How many times a failed scenario is retried, so the default 2 means three attempts
# (0–10). Applies to the scenario projects on every run, CI or local — these tests
# drive a real WordPress over the network, and a single blip should not end a run.
# Each attempt is fresh: the @plugin hooks reinstall the plugin and sweep residue per
# attempt. A scenario that only passes on a retry is reported FLAKY, not passed. Set 0
# to fail fast while debugging. Unit tests (npm run test:unit) never retry.
# E2E_RETRIES=2

# ── Terminal output ──────────────────────────────────────────────────────────
# auto (default): styled on a terminal, plain lines when piped or redirected; plain: no
# colour, no cursor movement, ASCII marks (the summary keeps its rule glyphs for now); fancy:
# as auto, and live even under CI. Anything else
# fails the run as it starts. NO_COLOR / FORCE_COLOR are honoured; the orchestrator's runs
# are plain (their stdout is a file).
# E2E_OUTPUT=auto

# ── Report retention ─────────────────────────────────────────────────────────
# Each run prunes its own cell's report folder as it ends: at most this many reports
# (0–10000; 0 = no cap, the age rules still apply), none older than 30 days except the
# newest complete one, kept up to 182 days. `npm run report:prune` applies the same policy to every cell (a dry run
# unless --apply) and takes this as its default --keep.
# E2E_REPORTS_KEEP=20

# ── Fleet health check (npm run healthcheck) ─────────────────────────────────
# Max sites checked concurrently within a product (1–32).
# HEALTHCHECK_CONCURRENCY=4
# Per-site UI-login settle budget in ms (1000–300000). Raise for slow remote
# (SSH-hosted) sites; the default is deliberately generous for a monitor.
# HEALTHCHECK_LOGIN_TIMEOUT_MS=30000
# Run the browser headed (visible on screen). `npm run healthcheck:ui` sets this.
# HEALTHCHECK_HEADED=false

# ── BackWPup storage credentials ─────────────────────────────────────────────
# Required for BackWPup remote-storage runs; ignored by WP Rocket. Any of these can
# be overridden per site via the "overrides" block in src/projects/backwpup/config/sites.json.
BWP_FTP_HOST=
BWP_FTP_USERNAME=
BWP_FTP_PASSWORD=
BWP_FTP_PORT=21
BWP_FTP_SECURE=true
BWP_S3_ACCESS_KEY_ID=
BWP_S3_SECRET_ACCESS_KEY=
BWP_S3_BUCKET=
BWP_S3_REGION=us-east-1
