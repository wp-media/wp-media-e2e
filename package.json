{
  "name": "wp-media-e2e",
  "version": "0.0.1",
  "description": "WP Media E2E Tests with Playwright",
  "license": "UNLICENSED",
  "author": "WP Media",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "playwright install chromium",
    "setup": "playwright install chromium",
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:wp-rocket": "bddgen --config playwright.wp-rocket.config.ts && playwright test --config playwright.wp-rocket.config.ts",
    "test:wp-rocket:ui": "bddgen --config playwright.wp-rocket.config.ts && playwright test --config playwright.wp-rocket.config.ts --ui",
    "test:wp-rocket:headed": "bddgen --config playwright.wp-rocket.config.ts && playwright test --config playwright.wp-rocket.config.ts --headed",
    "test:backwpup": "bddgen --config playwright.backwpup.config.ts && playwright test --config playwright.backwpup.config.ts",
    "test:backwpup:ui": "bddgen --config playwright.backwpup.config.ts && playwright test --config playwright.backwpup.config.ts --ui",
    "test:backwpup:headed": "bddgen --config playwright.backwpup.config.ts && playwright test --config playwright.backwpup.config.ts --headed",
    "test:ui": "bddgen && playwright test --ui",
    "test:headed": "bddgen && playwright test --headed",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:unit:ui": "playwright test --config playwright.unit.config.ts --ui",
    "healthcheck": "tsx healthcheck.ts",
    "healthcheck:ui": "tsx healthcheck.ts --headed",
    "artifacts:warm": "tsx warm-artifacts.ts",
    "fixtures:capture": "tsx capture-backwpup-fixtures.ts",
    "report": "tsx scripts/report.mjs",
    "report:allure": "tsx scripts/allure.mjs",
    "report:prune": "tsx prune-reports.ts",
    "env:up": "bash docker/setup.sh",
    "env:down": "docker compose -f docker/docker-compose.yml down -v",
    "env:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "orchestrator": "exec node --import tsx orchestrator/cli.ts",
    "orchestrator:soak": "ORCHESTRATOR_SOAK=1 playwright test --config playwright.unit.config.ts --project=orchestrator soak.spec"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/pngjs": "^6.0.5",
    "adm-zip": "^0.6.0",
    "allure": "^3.14.0",
    "allure-playwright": "^3.10.2",
    "apvm-napi": "github:wp-media/automation-plugin-version-manager#cli/v3.0.0",
    "commander": "^15.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^10.0.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "node-ssh": "^13.2.1",
    "pixelmatch": "^7.2.0",
    "playwright-bdd": "^9.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.4",
    "string-width": "^8.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "ssh2@1.17.0": true,
    "esbuild@0.28.2": true,
    "github:wp-media/automation-plugin-version-manager": false
  }
}
