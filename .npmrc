# Run install scripts on `npm install`/`npm ci`, overriding a globally-set
# `ignore-scripts=true` for this repo only: the root `postinstall` downloads Chromium
# (`playwright install chromium`) and `prepare` sets up husky. npm 12 runs a
# dependency's install scripts only when package.json's `allowScripts` lists it
# (`npm install-scripts ls` shows what is unreviewed); review a new dependency's
# scripts before approving them.
#
# `allowScripts` also denies apvm-napi's `prepare: husky` (its own repo's git hooks)
# by the git spec: keep that key. npm's answer depends on what it reads: from the
# hidden lockfile (node_modules/.package-lock.json, current after an install) it sees
# no script in the git dependency, from the installed tree (no hidden lockfile, or
# node_modules touched after it) it does, and without the key `ls` then reports the
# script unreviewed and a changed pin's install warns it blocked. So `npm
# install-scripts prune --dry-run`, on macOS after an install, must list that key
# alone, and is never applied as is. Reading the tree it also lists fsevents@2.3.3, and
# on Linux (fsevents is macOS-only, never installed) it always does: prune on macOS only.
ignore-scripts=false

# npm 12 refuses git dependencies by default (`allow-git=none`). `apvm-napi` is
# pinned to a git ref because APVM ships no npm package — it commits prebuilt native
# binaries to its repo instead. `root` permits only the git dependencies declared in
# this package.json; a transitive one pulled in by any other dependency stays blocked.
# Changing that pin needs `npm install --allow-git=all` once (`root` refuses a changed
# git pin with EALLOWGIT); `npm ci` then installs it under `root`.
allow-git=root
